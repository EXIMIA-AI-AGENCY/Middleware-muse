# Copia este archivo a .env (nunca lo subas a git) y rellena los valores.

# --- Obligatorias -------------------------------------------------------------
# Token de GoHighLevel: sub-account Eximia -> Settings -> Private Integrations -> "Muse".
GHL_TOKEN=
# Llave que Muse enviará en el header X-Proxy-Key (mínimo 32 caracteres).
# Genérala con: openssl rand -hex 32
PROXY_KEY=

# --- Opcionales ---------------------------------------------------------------
# PIN del panel /admin (6-64 caracteres; se recomiendan 8 dígitos). Vacío = sin panel.
ADMIN_PIN=
# Puerto HTTP (Railway/Render/Fly lo inyectan solos).
PORT=8080
# locationId que se envía por defecto al MCP de GHL (header locationId).
GHL_LOCATION_ID=L3bLLVwvhdJ7A9WqkPxM
# Rate limit por llave: RATE_LIMIT_MAX requests por ventana de RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=10000
# Timeout de inactividad hacia GHL, en ms.
UPSTREAM_TIMEOUT_MS=120000
# User-Agent de navegador que se envía a GHL (vacío = Chrome de escritorio actual).
UPSTREAM_USER_AGENT=
