# Copia este archivo a .env (nunca lo subas a git) y rellena los valores.

# --- Obligatorias -------------------------------------------------------------
# Token de GoHighLevel: sub-account Eximia -> Settings -> Private Integrations -> "Muse".
GHL_TOKEN=
# Llave que Muse enviará en el header X-Proxy-Key (mínimo 32 caracteres).
# Genérala con: openssl rand -hex 32
PROXY_KEY=

# --- Opcionales ---------------------------------------------------------------
# PIN del panel /admin (6-64 caracteres; se recomiendan 8 dígitos). Vacío = sin panel.
ADMIN_PIN=
# Puerto HTTP (Railway/Render/Fly lo inyectan solos).
PORT=8080
# locationId que se envía por defecto al MCP de GHL (header locationId).
GHL_LOCATION_ID=L3bLLVwvhdJ7A9WqkPxM
# Rate limit por llave: RATE_LIMIT_MAX requests por ventana de RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=10000
# Timeout de inactividad hacia GHL, en ms.
UPSTREAM_TIMEOUT_MS=120000
# User-Agent de navegador que se envía a GHL (vacío = Chrome de escritorio actual).
UPSTREAM_USER_AGENT=

# --- Kraken (opcional; sin estas variables GoHighLevel funciona igual) --------
# API key y Private key de Kraken (Settings -> API). Llave solo para Muse, sin
# permisos de retiro. Ver README -> Kraken.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Solo "true" (exacto) permite órdenes. Vacío = solo lectura.
ENABLE_TRADING=
# Opcional: llave de Muse para Kraken (32+ caracteres). Vacía = se deriva de las dos claves.
KRAKEN_PROXY_KEY=
# Opcional: dirección que el panel da a Muse para Kraken.
KRAKEN_PUBLIC_HOST=

# --- GoHighLevel Agencia (opcional; sin estas variables todo funciona igual) ---
# Token de la Private Integration de la AGENCIA (vista de Agencia -> Settings ->
# Private Integrations). Distinto de GHL_TOKEN. Ver README -> GoHighLevel Agencia.
GHL_AGENCY_TOKEN=
# Opcional: llave de Muse para la agencia (32+ caracteres). Vacía = se deriva del token.
GHL_AGENCY_PROXY_KEY=
# Opcional: dirección que el panel da a Muse para la agencia.
GHL_AGENCY_PUBLIC_HOST=
# Opcional: ID de la agencia (vacío = el panel lo lee solo).
GHL_COMPANY_ID=
# Solo "true" (exacto) permite borrar subcuentas. Vacío = bloqueado.
GHL_AGENCY_ALLOW_DELETE=
